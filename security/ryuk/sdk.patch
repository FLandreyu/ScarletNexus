+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"testing"
+	"time"
+
+	"github.com/containerd/errdefs"
+	"github.com/moby/go-archive"
+	"github.com/moby/go-archive/compression"
+	"github.com/moby/moby/api/types/build"
+	"github.com/moby/moby/api/types/container"
+	"github.com/moby/moby/api/types/jsonstream"
+	"github.com/moby/moby/client"
+	"github.com/stretchr/testify/require"
+)
+
+// A fork must not broaden a session filter to other Testcontainers resources.
+func TestUnselectedSessionResourcesSurvive(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	cli := testClient(t)
+	labels := map[string]string{labelBase: "true", labelBase + ".sessionID": testID()}
+	c, err := cli.ContainerCreate(ctx, client.ContainerCreateOptions{Name: testID(), Config: &container.Config{Image: testImage, Labels: labels}})
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		_, err := cli.ContainerRemove(context.Background(), c.ID, client.ContainerRemoveOptions{Force: true, RemoveVolumes: true})
+		require.True(t, err == nil || errdefs.IsNotFound(err))
+	})
+	n, err := cli.NetworkCreate(ctx, testID(), client.NetworkCreateOptions{Labels: labels})
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		_, err := cli.NetworkRemove(context.Background(), n.ID, client.NetworkRemoveOptions{})
+		require.True(t, err == nil || errdefs.IsNotFound(err))
+	})
+	v, err := cli.VolumeCreate(ctx, client.VolumeCreateOptions{Name: testID(), Labels: labels})
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		_, err := cli.VolumeRemove(context.Background(), v.Volume.Name, client.VolumeRemoveOptions{Force: true})
+		require.True(t, err == nil || errdefs.IsNotFound(err))
+	})
+	source, err := archive.Tar("testdata", compression.None)
+	require.NoError(t, err)
+	defer source.Close()
+	arg := testID()
+	result, err := cli.ImageBuild(ctx, source, client.ImageBuildOptions{Version: build.BuilderBuildKit, BuildArgs: map[string]*string{"arg1": &arg}, Labels: labels})
+	require.NoError(t, err)
+	defer result.Body.Close()
+	imageID := ""
+	decoder := json.NewDecoder(result.Body)
+	for {
+		var message jsonstream.Message
+		err := decoder.Decode(&message)
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		require.NoError(t, err)
+		require.Nil(t, message.Error)
+		if message.ID == imageBuildResult && message.Aux != nil {
+			var value build.Result
+			require.NoError(t, json.Unmarshal(*message.Aux, &value))
+			imageID = value.ID
+		}
+	}
+	require.NotEmpty(t, imageID)
+	t.Cleanup(func() {
+		_, err := cli.ImageRemove(context.Background(), imageID, client.ImageRemoveOptions{Force: true, PruneChildren: true})
+		require.True(t, err == nil || errdefs.IsNotFound(err))
+	})
+	testReaper(ctx, t, "msg=removed containers=0 networks=0 volumes=0 images=0")
+	_, err = cli.ContainerInspect(ctx, c.ID, client.ContainerInspectOptions{})
+	require.NoError(t, err)
+	_, err = cli.NetworkInspect(ctx, n.ID, client.NetworkInspectOptions{})
+	require.NoError(t, err)
+	_, err = cli.VolumeInspect(ctx, v.Volume.Name, client.VolumeInspectOptions{})
+	require.NoError(t, err)
+	_, err = cli.ImageInspect(ctx, imageID)
+	require.NoError(t, err)
+}
