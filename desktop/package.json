{
  "name": "scarlet-nexus-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Scarlet Nexus Windows desktop host",
  "main": "main.cjs",
  "scripts": {
    "start": "node run.cjs",
    "test": "node --test test/*.test.cjs",
    "test:smoke": "node test/smoke.cjs",
    "test:runtime": "node test/runtime-smoke.cjs",
    "test:managed": "node test/managed-smoke.cjs",
    "test:lifecycle": "node test/lifecycle-smoke.cjs",
    "check": "node --check main.cjs && node --check runtime.cjs && node --check setup-preload.cjs && node --check setup.js"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "playwright": "1.65.1"
  }
}
